{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@sil/support-data": ["../packages/support-data/src/index.ts"],
      "@sil/support-data/*": ["../packages/support-data/src/*"]
    },
    "resolveJsonModule": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "bindings",
    "../packages/support-data/src/**/*.ts",
    "../packages/support-data/src/**/*.svelte"
  ],
  "exclude": [
    "../packages/support-data/src/**/*.test.ts",
    "src/paraglide/**",
    "src/lib/paraglide/**"
  ]
}
