{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "paraglide:compile": "paraglide-js compile --project ./paraglide/default.inlang",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@wailsio/runtime": "latest",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "daisyui": "^5.7.47",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^8.0.5"
  },
  "volta": {
    "node": "22.23.2"
  }
}
