go.work
go.work.sum

# ============================================================
# Wails
# ============================================================

# Wails build output
/.task
/build/bin/

# Generated mobile (per-machine; overlays hold absolute paths)
/build/ios/xcode/overlay.json
/build/ios/xcode/gen/
/build/android/overlay.json
/build/android/gen/
# Gradle's own cache/output (regenerated by any Android build)
/build/android/.gradle/
/build/android/**/build/

